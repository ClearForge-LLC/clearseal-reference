# Environment variables the reference reads, by name. Never commit a value (N8).

# HMAC key for MRTR requestState (CSR-WO-1005). At least 32 bytes. Unset: no request state is
# issued or accepted, and a tool that needs one fails closed.
CLEARSEAL_REQUEST_STATE_KEY=

# A bearer token for manual runs against a test verifier only. The core's verifier (CSR-WO-1003)
# never accepts it; tests generate their own at run time.
CLEARSEAL_TEST_BEARER=

# CSR-WO-0101 approval-transport spike (spikes/0101-approval). A static spike bearer, at least 32
# characters; without it the spike server refuses to start. Never leave the spike running. The
# spike does NOT need CLEARSEAL_REQUEST_STATE_KEY: when it is unset, the spike makes a fresh key
# for its own process, never stored.
CLEARSEAL_SPIKE_BEARER=
# Optional: the spike's loopback port (default 3999), extra Host / Origin values (comma lists,
# added to the loopback defaults), and the URL named in its 401 challenge.
CLEARSEAL_SPIKE_PORT=
CLEARSEAL_SPIKE_ALLOWED_HOSTS=
CLEARSEAL_SPIKE_ALLOWED_ORIGINS=
CLEARSEAL_SPIKE_RESOURCE_URL=

# The edition this node serves (CSR-WO-1007b). Required: the package name of the edition, resolved from
# the operator's own install. The core's `clearseal-node` reads every setting here, and the manifest,
# before it imports that package, so nothing the edition runs at load time can change one. A path or a
# URL is refused: only a package name.
CLEARSEAL_EDITION=

# The approved manifest (CSR-WO-1007a). Required: an absolute path or a file: URL to the manifest the
# operator approved. The node refuses to start without it, reads it once (a regular file, no link on
# the path), and writes one manifest-loaded audit line with its path and SHA-256. An edition never
# names it. For the teaching edition: the repository's pins/teaching.json.
CLEARSEAL_MANIFEST=

# The audit store (CSR-WO-2002). Required: a node records every refusal and every call that reaches
# a handler, or does not start. Each row hashes its predecessor and carries the principal; tool
# arguments appear only as keyed HMAC digests. Every AUDIT_CHECKPOINT_ROWS rows or
# AUDIT_CHECKPOINT_SECONDS seconds, whichever first, and on close, a signed checkpoint goes to the
# anchor, a separate file you own. Check a log with:
#   npm run audit -- verify --log <AUDIT_LOG> --anchor <AUDIT_ANCHOR> --keys <allowlist.json>
# (the allowlist: [{ "kid", "key" (raw Ed25519 public key, base64url), "notBefore", "notAfter" }]).
# Paths are absolute, regular files with no link on the way; the log and anchor are created (0600)
# if absent. Development keys: node scripts/audit-dev-keys.mjs <dir outside the repository>
# (NOT FOR PRODUCTION). The one exception: AUDIT_STORE=seam-only keeps the stderr line, writes a
# loud audit-unanchored row first, and is for development only.
AUDIT_STORE=
AUDIT_LOG=
AUDIT_ANCHOR=
AUDIT_DIGEST_KEY_FILE=
AUDIT_DIGEST_KEY_ID=
AUDIT_SIGNING_KEY_FILE=
AUDIT_SIGNING_KEY_ID=
# Optional: checkpoint every N rows (default 100) or T seconds (default 300). Rows after the last
# checkpoint can be truncated unseen; these bound that window.
AUDIT_CHECKPOINT_ROWS=
AUDIT_CHECKPOINT_SECONDS=

# The pin gate (CSR-WO-1001). Strict unless set to exactly false. Strict: any unpinned, drifted,
# invalid or removed tool stops the node before it binds. false: refused tools are absent and the
# node starts, saying so in its log. A missing or unparseable manifest stops the node either way.
PIN_STRICT=

# Containment (CSR-WO-1002, N7). Forbidden unless set to exactly false: every arbitrary_exec tool is
# refused at construction. An edition that turns this off must document why in its own tree; even
# then an arbitrary_exec tool is refused a containment domain.
EXEC_TOOLS_FORBIDDEN=

# The resource server's token verifier (CSR-WO-1003). The node refuses to start when the issuer, the
# key-set URL or the audience is blank. The key-set URL must be https:. The issuer is compared to
# the token's iss exactly; the audience to its aud exactly (one audience). The protected-resource
# URL itself is the transport's resourceUrl setting, also required.
AUTH_ISSUER=
AUTH_JWKS_URL=
AUTH_AUDIENCE=
# Optional: key-set cache lifetime in seconds (default 300), the stated clock skew in seconds
# (default 60, at most 300), and the signature algorithms allowed (default ES256,EdDSA,RS256; none
# and HMAC are never allowed).
# The numeric AUTH_* settings are plain decimal digits.
AUTH_JWKS_TTL_S=300
AUTH_CLOCK_SKEW_S=60
AUTH_ALGS=ES256,EdDSA,RS256
# Optional (CSR-WO-1003a): the furthest a token's exp may lie beyond now plus the skew, in seconds
# (default 86400, 60 to 604800).
AUTH_MAX_TOKEN_LIFETIME_S=86400
# Optional: true accepts only typ at+jwt or application/at+jwt (RFC 9068); false (the default)
# also accepts JWT, application/jwt and an absent typ. Anything else refuses start.
AUTH_REQUIRE_AT_JWT=false
# Optional: a PEM file of CA certificates for an issuer on a private CA, read once at start and
# trusted by the key-set client alone, never process-wide. Setting it REPLACES the default roots for
# that one client: the key-set URL must then chain to a certificate in this file.
AUTH_JWKS_CA_FILE=

# The dev OIDC harness only (packages/core/dev/oidc, NOT FOR DEPLOYMENT): its one client's secret,
# at least 32 characters. Never used by a node.
DEV_OIDC_CLIENT_SECRET=

# The teaching edition (CSR-WO-1004, CSR-WO-1007; packages/teaching, its configSchema). The core's
# startNode reads these and refuses to start on a value outside the schema, an unknown TEACHING_
# variable included. It also needs CLEARSEAL_MANIFEST, the AUDIT_* settings (or AUDIT_STORE=seam-only
# for development) and the AUTH_* settings above, and reads PIN_STRICT.
# Required: the protected-resource URL named in every 401 and the metadata document.
TEACHING_RESOURCE_URL=
# Optional: the bind address (default 127.0.0.1) and port (default 3030; 0 picks a free one).
TEACHING_HOST=
TEACHING_PORT=
# The notes store is not configuration: the root (/srv/clearseal/teaching/notes) is pinned in
# pins/teaching.json, the manifest to point CLEARSEAL_MANIFEST at. Moving the root is a code change
# and a re-approved manifest, never a variable.
