+const UTF8 = new TextDecoder("utf-8", { fatal: true, ignoreBOM: true });
+export function decodeStrict(input: string | Uint8Array): string | undefined {
+  if (typeof input === "string") return input;
+  try {
+    return UTF8.decode(input);
+  } catch {
+    return undefined;
+  }
