{
  "name": "clearseal-reference",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "lint": "eslint --max-warnings 0 .",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "leak-gate": "node scripts/leak-gate.mjs --self-test && node scripts/leak-gate.mjs --tree && node scripts/leak-gate.mjs --history"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
