{
  "name": "clearseal-reference",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "spikes/0100-protocol"
  ],
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "lint": "eslint --max-warnings 0 . && node scripts/check-directives.mjs",
    "build": "npm run build --workspaces",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test",
    "leak-gate": "node scripts/leak-gate.mjs --self-test && node scripts/leak-gate.mjs --tree && node scripts/leak-gate.mjs --history"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
