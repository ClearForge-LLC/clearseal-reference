{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "src/**/*.mts", "src/**/*.cts"]
}
